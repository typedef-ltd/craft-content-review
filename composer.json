{
  "name": "typedef/craft-content-review",
  "description": "A Craft CMS 5 plugin for scheduling recurring content reviews, assigning reviewers, and sending reminders.",
  "type": "craft-plugin",
  "license": "proprietary",
  "support": {
    "email": "joe@typedef.co",
    "issues": "https://github.com/typedef/craft-content-review/issues?state=open",
    "source": "https://github.com/typedef/craft-content-review",
    "docs": "https://github.com/typedef/craft-content-review/blob/main/README.md"
  },
  "require": {
    "php": ">=8.2",
    "craftcms/cms": "^5.0.0"
  },
  "require-dev": {
    "codeception/codeception": "^5.2.0",
    "codeception/module-asserts": "^3.0.0",
    "codeception/module-yii2": "^1.1.9",
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "vlucas/phpdotenv": "^5.4.1"
  },
  "autoload": {
    "psr-4": {
      "typedef\\contentreview\\": "src/"
    }
  },
  "extra": {
    "name": "Content Review",
    "handle": "content-review",
    "developer": "Typedef Limited",
    "developerUrl": "https://www.typedef.co",
    "class": "typedef\\contentreview\\ContentReviewPlugin"
  },
  "scripts": {
    "ecs-check": "ecs check --ansi",
    "ecs-fix": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "codecept run --fail-fast",
    "test-unit": "codecept run unit --fail-fast",
    "test-integration": "codecept run integration --fail-fast"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  },
  "autoload-dev": {
    "psr-4": {
      "typedef\\contentreview\\tests\\support\\": "tests/_support/"
    }
  }
}
